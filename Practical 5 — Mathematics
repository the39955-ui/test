\section{Mathematical Expressions}

Simple equation:

\[
x + y = 10
\]

Power:

\[
x^2 + y^2
\]

Subscript:

\[
x_1 + x_2
\]

Fraction:

\[
\frac{a}{b}
\]

Square root:

\[
\sqrt{x}
\]

Cube root:

\[
\sqrt[3]{x}
\]

Greek letters:

\[
\alpha + \beta + \gamma = \theta
\]

Summation:

\[
\sum_{i=1}^{n} i
\]

Integral:

\[
\int_0^1 x^2\,dx
\]

Limit:

\[
\lim_{x\rightarrow 0} \frac{\sin x}{x}
\]

\section{Quadratic Equation}

\[
x = \frac{-b \pm \sqrt{b^2-4ac}}{2a}
\]

\section{Aligned Equations}

\begin{align}
x + y &= 10 \\
x - y &= 2 \\
2x &= 12
\end{align}

\section{Numbered Equation}

\begin{equation}
E = mc^2
\end{equation}

